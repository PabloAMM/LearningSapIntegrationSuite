<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     XSD principal del feed OData V2 (Atom)
     Servicio : ZUSER_DETAILS_SRV
     EntitySet: userdetailsSet
     Root     : {http://www.w3.org/2005/Atom}feed
     Depende de: odata_metadata.xsd -> odata_dataservices.xsd
     ============================================================ -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:atom="http://www.w3.org/2005/Atom"
           xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata"
           targetNamespace="http://www.w3.org/2005/Atom"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <xs:import namespace="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata"
               schemaLocation="odata_metadata.xsd"/>

    <!-- ================= Root ================= -->
    <xs:element name="feed">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="atom:id"/>
                <xs:element ref="atom:title"/>
                <xs:element ref="atom:updated"/>
                <xs:element ref="atom:author"  minOccurs="0"/>
                <xs:element ref="atom:link"    minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="atom:entry"   minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <!-- admite xml:base -->
            <xs:anyAttribute namespace="##other" processContents="lax"/>
        </xs:complexType>
    </xs:element>

    <!-- ================= Entry ================= -->
    <xs:element name="entry">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="atom:id"/>
                <xs:element ref="atom:title"/>
                <xs:element ref="atom:updated"/>
                <xs:element ref="atom:author"   minOccurs="0"/>
                <xs:element ref="atom:category" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="atom:link"     minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="atom:content"  minOccurs="0"/>
                <!-- OData V2: m:properties fuera de content en entidades media -->
                <xs:element ref="m:properties"  minOccurs="0"/>
            </xs:sequence>
            <xs:anyAttribute namespace="##other" processContents="lax"/>
        </xs:complexType>
    </xs:element>

    <!-- ================= Content ================= -->
    <xs:element name="content">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="m:properties" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="type" type="xs:string"/>
            <xs:attribute name="src"  type="xs:anyURI"/>
        </xs:complexType>
    </xs:element>

    <!-- ================= Elementos Atom comunes ================= -->
    <xs:element name="id" type="xs:anyURI"/>

    <xs:element name="title">
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute name="type" type="xs:string"/>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="updated" type="xs:dateTime"/>

    <xs:element name="author">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="name"  type="xs:string" minOccurs="0"/>
                <xs:element name="uri"   type="xs:anyURI" minOccurs="0"/>
                <xs:element name="email" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="category">
        <xs:complexType>
            <xs:attribute name="term"   type="xs:string"/>
            <xs:attribute name="scheme" type="xs:anyURI"/>
            <xs:attribute name="label"  type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="link">
        <xs:complexType>
            <xs:attribute name="href"  type="xs:string"/>
            <xs:attribute name="rel"   type="xs:string"/>
            <xs:attribute name="title" type="xs:string"/>
            <xs:attribute name="type"  type="xs:string"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
